<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.realapex</groupId>
        <artifactId>ai-workbench</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-agent-sdk</artifactId>
    <name>AI Agent SDK</name>
    <description>ReAct 智能体编排 SDK：工具注册、ReAct 循环、虚拟线程并发调度、上下文裁剪、生命周期事件</description>

    <dependencies>
        <!-- 单向依赖 ai-client-sdk -->
        <dependency>
            <groupId>com.realapex</groupId>
            <artifactId>ai-client-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 单向依赖 ai-tool-sdk（工具契约基座） -->
        <dependency>
            <groupId>com.realapex</groupId>
            <artifactId>ai-tool-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JSON 处理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 日志门面 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot 自动配置（可选） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Context（@Tool 注解扫描需要） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>6.2.1</version>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
